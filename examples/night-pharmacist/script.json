          "beats": [
            {
              "type": "action",
              "text": "墙上电子钟跳到 02:00。玻璃门被推开，风铃响。",
              "seconds": 2
            },
            {
              "type": "action",
              "text": "小雨把一张处方拍在柜台上，帽檐压得很低。"
            },
            {
              "type": "dialogue",
              "characterId": "xiao-yu",
              "text": "止咳水，六瓶。",
              "emotion": "不耐烦"
            },
            {
              "type": "action",
              "text": "林晚拿起处方，对着灯看医生签章。"
            },
            {
              "type": "voiceover",
              "characterId": "lin-wan",
              "text": "同一个少年，同一个签名，这个月第三次。"
            },
            {
              "type": "action",
              "text": "林晚用指腹蹭签章边缘，红印纹丝不动。",
              "seconds": 3
            },
            {
              "type": "dialogue",
              "characterId": "lin-wan",
              "text": "这个章是印上去的，不是盖的。这单我不能发。",
              "emotion": "平静"
            },
            {
              "type": "dialogue",
              "characterId": "xiao-yu",
              "text": "上次不是卖了吗？",
              "emotion": "慌"
            },
            {
              "type": "action",
              "text": "后库门开，赵德明笑着走出来，顺手把处方抽走。"
            },
            {
              "type": "dialogue",
              "characterId": "zhao-deming",
              "text": "老顾客了，小林你太较真。我来发。",
              "emotion": "和气"
            },
            {
              "type": "action",
              "text": "赵德明从柜里取出六瓶止咳水装袋，小雨抓起袋子就走。",
              "seconds": 3
            },
            {
              "type": "dialogue",
              "characterId": "lin-wan",
              "text": "赵总，这出了事是我的执业证。",
              "emotion": "压着火"
            },
            {
              "type": "dialogue",
              "characterId": "zhao-deming",
              "text": "出不了事。去后库把纸箱收一收。",
              "emotion": "笑意不达眼底"
            }
          ]
        },
        {
