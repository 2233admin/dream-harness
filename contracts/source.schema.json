{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-harness/source.schema.json",
  "title": "story/source/index.json：dh import 生成的小说章节索引；不要手改",
  "type": "object",
  "required": ["schemaVersion", "file", "encoding", "splitBy", "chapters"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "file": { "type": "string", "minLength": 1 },
    "encoding": { "enum": ["utf-8", "gb18030"] },
    "splitBy": { "enum": ["heading", "size"] },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "title", "file", "chars"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "file": { "type": "string", "pattern": "^chapters/[0-9]{4}\\.txt$" },
          "chars": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
