{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dream-harness/cast.schema.json",
  "title": "cast.json：角色设定；给人读的字段用项目语言，喂给模型的提示词一律英文",
  "type": "object",
  "required": ["schemaVersion", "characters"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "characters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/character" } },
    "locked": { "$ref": "#/$defs/locked" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "anchor": {
      "type": "object",
      "required": ["name", "prompt"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 2 }
      }
    },
    "locked": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      }
    },
    "character": {
      "type": "object",
      "required": ["id", "age", "look", "anchors", "outfits", "defaultOutfit", "imagePrompt", "voice"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "age": { "type": "string", "minLength": 1 },
        "look": { "type": "string", "minLength": 1 },
        "anchors": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/anchor" } },
        "outfits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "prompt"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 2 }
            }
          }
        },
        "defaultOutfit": { "$ref": "#/$defs/id" },
        "imagePrompt": { "type": "string", "minLength": 20 },
        "negativePrompt": { "type": "string" },
        "voice": {
          "type": "object",
          "required": ["timbre", "pace", "emotion", "prompt"],
          "additionalProperties": false,
          "properties": {
            "timbre": { "type": "string", "minLength": 1 },
            "pace": { "type": "string", "minLength": 1 },
            "emotion": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  }
}
