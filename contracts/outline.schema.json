{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dream-harness/outline.schema.json",
  "title": "outline.json：分集大纲与资产清单；三种写文入口在此汇合",
  "type": "object",
  "required": ["schemaVersion", "characters", "locations", "props", "episodes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "adaptation": { "$ref": "#/$defs/adaptation" },
    "characters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/character" } },
    "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } },
    "props": { "type": "array", "items": { "$ref": "#/$defs/prop" } },
    "episodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/episode" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "adaptation": {
      "type": "object",
      "required": ["mode", "cut", "merged", "keep"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["faithful", "core", "shell"] },
        "cut": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["what", "why"],
            "additionalProperties": false,
            "properties": {
              "what": { "type": "string", "minLength": 1 },
              "why": { "type": "string", "minLength": 1 }
            }
          }
        },
        "merged": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["into", "from", "why"],
            "additionalProperties": false,
            "properties": {
              "into": { "$ref": "#/$defs/id" },
              "from": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
              "why": { "type": "string", "minLength": 1 }
            }
          }
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["what", "evidence"],
            "additionalProperties": false,
            "properties": {
              "what": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 4 }
            }
          }
        },
        "note": { "type": "string" }
      }
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "role", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["protagonist", "antagonist", "supporting", "extra"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "prop": {
      "type": "object",
      "required": ["id", "name", "summary", "narrative"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "narrative": { "type": "boolean" }
      }
    },
    "episode": {
      "type": "object",
      "required": ["number", "title", "synopsis", "hook", "payoffs", "characters", "locations"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "synopsis": { "type": "string", "minLength": 1 },
        "hook": {
          "type": "object",
          "required": ["opening", "cliffhanger"],
          "additionalProperties": false,
          "properties": {
            "opening": { "type": "string", "minLength": 1 },
            "cliffhanger": { "type": "string" }
          }
        },
        "payoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "text"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["reversal", "face-slap", "reveal", "romance", "revenge", "comedy", "other"] },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "characters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "props": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "source": {
          "type": "object",
          "required": ["chapters"],
          "additionalProperties": false,
          "properties": {
            "chapters": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    }
  }
}
